# ClaimFlow Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector
POSTGRES_USER=claimflow
POSTGRES_PASSWORD=claimflow_secret
POSTGRES_DB=claimflow_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://claimflow:claimflow_secret@localhost:5432/claimflow_db
# SQLite fallback for local test execution without Docker
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./claimflow_dev.db

# Redis Streams Event Bus
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# LLM Providers (Optional for Phase 0/1 synthetic engine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Clearinghouse SLA Parameters (in seconds)
SLA_MAX_SECONDS=900
INGEST_BUDGET_SECONDS=10
PARSER_BUDGET_SECONDS=45
VALIDATION_BUDGET_SECONDS=60
FRAUD_BUDGET_SECONDS=15
DECISION_BUDGET_SECONDS=30
